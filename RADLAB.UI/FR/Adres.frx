      <TableDataSource Name="Table" Alias="Q" DataType="System.Int32" Enabled="true" SelectCommand="SELECT&#13;&#10;	UPPER(CASE&#13;&#10;				WHEN ISNULL(Kalibrasyon.AdSoyadBasvuru, '') != '' THEN Kalibrasyon.AdSoyadBasvuru&#13;&#10;				WHEN ISNULL(Kalibrasyon.UnvanBasvuru, '') != '' THEN Kalibrasyon.UnvanBasvuru&#13;&#10;			END) AS AdSoyadUnvan,&#13;&#10;	UPPER(Kalibrasyon.AdresBasvuru + ' ' + Ilce.IlIlce + ' ' + Il.IlIlce) AS Adres,&#13;&#10;	Kalibrasyon.TelefonCep&#13;&#10;FROM&#13;&#10;	Kalibrasyon&#13;&#10;	LEFT JOIN IlIlce Ilce ON Kalibrasyon.IlIlceIdBasvuru = Ilce.Id&#13;&#10;	LEFT JOIN IlIlce Il ON Ilce.ParentId = Il.Id&#13;&#10;WHERE&#13;&#10;	Kalibrasyon.Id = @PrmId">
