      <TableDataSource Name="Table" Alias="Q" DataType="System.Int32" Enabled="true" SelectCommand="SELECT&#13;&#10;	KalibrasyonCihaz.Id,&#13;&#10;	'KT: ' + CONVERT(VARCHAR(10), KalibrasyonCihaz.KalibrasyonTarihi, 104) AS KalibrasyonTarihi,&#13;&#10;	CASE&#13;&#10;		WHEN Ayar.EtiketIkiTarihli = 0 THEN ''&#13;&#10;		ELSE 'GT: ' + CONVERT(VARCHAR(10), DATEADD(YEAR, 2, KalibrasyonCihaz.KalibrasyonTarihi), 104)&#13;&#10;	END AS KalibrasyonTarihininIkiyilSonrasi&#13;&#10;FROM&#13;&#10;	KalibrasyonCihaz&#13;&#10;	LEFT JOIN Ayar ON 0 = 0&#13;&#10;WHERE&#13;&#10;	KalibrasyonCihaz.Id IN (SELECT Id FROM dbo.FIdList(@PrmIdler))">
